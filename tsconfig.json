{
  // Typecheck + vitest resolution facade for the plugin.
  // Resolves @deepseek-ai/* from this package's own node_modules, where the
  // devDependencies pin the published 0.1.2-rc.1 type artifacts — the same
  // packages the dsh 0.1.2-rc.1 host provides at runtime. Run `npm install`
  // once after changing devDependencies, then build with `npm run build`.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["src", "tests"]
}
